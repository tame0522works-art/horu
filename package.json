{
  "name": "horu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "地表を掘って、出てきた地層から地下の断面を推理するゲーム",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "tsx tools/check-engine.ts && tsx tools/check-puzzles.ts",
    "check:engine": "tsx tools/check-engine.ts",
    "check:puzzles": "tsx tools/check-puzzles.ts",
    "show": "tsx tools/show.ts",
    "e2e": "vite build --outDir dist-e2e --emptyOutDir && tsx tools/e2e.ts",
    "screenshots": "tsx tools/screenshots.ts",
    "fill-best": "tsx tools/fill-best.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  }
}
